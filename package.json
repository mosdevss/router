{
  "name": "router",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "router:gen": "tanstack-router generate",
    "predeploy": "pnpm build && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "sass": "^1.102.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.0"
  }
}
